// Schéma de la base de données Get iT.
// Conventions : modèles en PascalCase, tables et colonnes en snake_case (@@map / @map),
// dates avec fuseau horaire (timestamptz).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Langues de l'interface. Doit rester aligné avec src/i18n/routing.ts.
enum Locale {
  fr
  en
}

/// Thème de l'interface ; « system » suit le réglage de l'appareil.
enum ThemePreference {
  system
  light
  dark
}

/// Les quatre piliers. Doit rester aligné avec src/config/pillars.ts.
enum Pillar {
  physical
  mental
  social
  financial
}

/// Situation professionnelle déclarée à l'onboarding. Alignée avec src/features/onboarding/schemas.ts.
enum Occupation {
  student
  employee
  self_employed
  entrepreneur
  job_seeker
  other
}

enum GoalStatus {
  active
  completed
  archived
}

/// Profil d'un utilisateur. L'id est celui du compte Supabase Auth (auth.users.id).
/// Rôle dans la plateforme (§43) ; les permissions sont vérifiées côté serveur.
enum UserRole {
  user
  moderator
  admin
}

/// Type de compte choisi à l'inscription : un affilié peut aussi vendre dans le Marketplace.
enum AccountType {
  consumer
  affiliate
}

/// Sexe à la naissance : deux choix.
enum Sex {
  male
  female
}

/// Pays où Get iT est offert.
enum Country {
  CA
  US
}

model Profile {
  id             String      @id @db.Uuid
  /// Nom d'utilisateur public du Centre Get iT (minuscules, chiffres, « _ »).
  username       String?     @unique
  role           UserRole    @default(user)
  accountType    AccountType @default(consumer) @map("account_type")
  /// Suspension du Centre Get iT par la modération ; null : pas suspendu.
  suspendedUntil DateTime?   @map("suspended_until") @db.Timestamptz(3)
  /// Prénom ou nom affiché, demandé à l'onboarding.
  displayName    String?     @map("display_name")
  /// Courte présentation, visible des membres du Centre (160 caractères au plus).
  bio            String?
  /// Photo de profil dans le compartiment privé « media » (lue par lien temporaire).
  avatarPath     String?     @map("avatar_path")
  occupation     Occupation?
  /// Piliers que l'utilisateur veut améliorer en priorité.
  focusPillars   Pillar[]    @default([]) @map("focus_pillars")
  /// Renseignements privés de la création du compte (jamais montrés aux autres) ;
  /// vides pour les comptes créés avant : demandés une fois à la prochaine ouverture.
  birthDate      DateTime?   @map("birth_date") @db.Date
  /// Sexe à la naissance (comparaisons physiques du mode Ranked).
  sex            Sex?
  country        Country?
  /// Province, territoire ou État (code postal officiel, ex. « QC », « NY »).
  province       String?
  /// Région administrative du Québec (mêmes clés que le Marketplace).
  qcRegion       String?     @map("qc_region")
  /// Fin de l'onboarding ; null tant qu'il n'est pas terminé.
  onboardedAt    DateTime?   @map("onboarded_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings             UserSettings?
  goals                Goal[]
  tasks                Task[]
  habits               Habit[]
  checkIns             DailyCheckIn[]
  journalEntries       JournalEntry[]
  journalMedia         JournalMedia[]
  assessments          PillarAssessment[]
  xpEvents             XpEvent[]
  aiRequests           AiRequest[]
  coachConversations   CoachConversation[]
  coachActions         CoachAction[]
  posts                Post[]
  postComments         PostComment[]
  postReactions        PostReaction[]
  postSaves            PostSave[]
  ownedGroups          Group[]              @relation("GroupOwner")
  groupMemberships     GroupMember[]        @relation("GroupMembership")
  groupInvitesSent     GroupMember[]        @relation("GroupInviter")
  reportsMade          ContentReport[]      @relation("ReportReporter")
  reportsReceived      ContentReport[]      @relation("ReportedUser")
  reportsResolved      ContentReport[]      @relation("ReportResolver")
  blocking             UserBlock[]          @relation("Blocker")
  blockedBy            UserBlock[]          @relation("Blocked")
  conversationsStarted Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messagesSent         Message[]
  messageReactions     MessageReaction[]
  mediaUploads         MediaUpload[]
  contactsRequested    Contact[]            @relation("ContactRequester")
  contactsReceived     Contact[]            @relation("ContactAddressee")
  pactsProposed        Pact[]               @relation("PactProposer")
  pactsEnded           Pact[]               @relation("PactEnder")
  pactMembers          PactMember[]
  listings             Listing[]            @relation("ListingSeller")
  listingsReviewed     Listing[]            @relation("ListingReviewer")
  listingFavorites     ListingFavorite[]
  developmentPlans     DevelopmentPlan[]
  rankedEvaluations    RankedEvaluation[]

  @@map("profiles")
}

/// Préférences personnelles, séparées du profil public.
model UserSettings {
  userId           String          @id @map("user_id") @db.Uuid
  /// Langue choisie : suit l'utilisateur sur tous ses appareils (web et future app mobile).
  locale           Locale          @default(fr)
  /// Fuseau IANA (ex. « America/Toronto ») : sert à calculer « aujourd'hui » et les séries.
  timeZone         String          @default("America/Toronto") @map("time_zone")
  /// Thème choisi dans Réglages : suit l'utilisateur sur tous ses appareils.
  theme            ThemePreference @default(system)
  /// Temps que l'utilisateur veut investir chaque jour, en minutes.
  dailyMinutes     Int?            @map("daily_minutes")
  /// Accord pour que Get iT AI reçoive les données de l'utilisateur (Loi 25) ; null : pas d'accord.
  aiConsentAt      DateTime?       @map("ai_consent_at") @db.Timestamptz(3)
  /// Acceptation des règles du Centre Get iT, avant la première publication.
  communityRulesAt DateTime?       @map("community_rules_at") @db.Timestamptz(3)
  /// Dernier jour (fuseau de l'utilisateur) où « Ma journée » s'est ouvert tout seul.
  dayPanelSeenOn   DateTime?       @map("day_panel_seen_on") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Objectif de l'utilisateur, découpé en jalons et en tâches.
model Goal {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  title             String
  description       String?
  pillar            Pillar
  status            GoalStatus @default(active)
  /// Jour visé : une date du calendrier, sans heure ni fuseau.
  targetDate        DateTime?  @map("target_date") @db.Date
  completedAt       DateTime?  @map("completed_at") @db.Timestamptz(3)
  /// Photo choisie pour l'objectif (compartiment privé « media », dossier posts/<userId>).
  photoPath         String?    @map("photo_path")
  /// Plan de « Mon développement » d'où vient l'objectif ; détaché si le plan est supprimé.
  developmentPlanId String?    @map("development_plan_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  developmentPlan DevelopmentPlan? @relation(fields: [developmentPlanId], references: [id], onDelete: SetNull)
  milestones      GoalMilestone[]
  tasks           Task[]
  habits          Habit[]
  /// XP de l'objectif atteint.
  xpEvent         XpEvent?

  @@index([userId, status])
  @@index([developmentPlanId])
  @@map("goals")
}

/// Grande étape d'un objectif. L'avancement de l'objectif se calcule sur ses jalons.
model GoalMilestone {
  id          String    @id @default(uuid(7)) @db.Uuid
  goalId      String    @map("goal_id") @db.Uuid
  title       String
  /// Ordre d'affichage dans l'objectif.
  position    Int
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  goal    Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@index([goalId, position])
  @@map("goal_milestones")
}

/// Action concrète, rattachée à un objectif ou indépendante (étape 6 : page Aujourd'hui).
/// Moment de la journée d'une habitude, d'une tâche ou d'une séance de plan.
enum DayMoment {
  morning
  noon
  evening
}

model Task {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  goalId            String?    @map("goal_id") @db.Uuid
  title             String
  /// Jour d'échéance : une date du calendrier, sans heure ni fuseau.
  dueDate           DateTime?  @map("due_date") @db.Date
  completedAt       DateTime?  @map("completed_at") @db.Timestamptz(3)
  /// Moment de la journée choisi (calendrier « Semaine ») ; null : dans la journée.
  moment            DayMoment?
  /// Plan de « Mon développement » d'où vient la tâche ; détachée si le plan est supprimé.
  developmentPlanId String?    @map("development_plan_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  developmentPlan DevelopmentPlan? @relation(fields: [developmentPlanId], references: [id], onDelete: SetNull)
  xpEvent         XpEvent?

  @@index([userId, completedAt])
  @@index([userId, dueDate])
  @@index([goalId])
  @@index([developmentPlanId])
  @@map("tasks")
}

/// Autoévaluation d'un pilier (1 à 5). Une ligne par évaluation : l'historique montre l'évolution.
model PillarAssessment {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pillar    Pillar
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pillar, createdAt])
  @@map("pillar_assessments")
}

/// Habitude à répéter certains jours de la semaine.
model Habit {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  /// Objectif soutenu par l'habitude ; détaché si l'objectif est supprimé.
  goalId            String?    @map("goal_id") @db.Uuid
  title             String
  pillar            Pillar
  /// Jours prévus, de 1 (lundi) à 7 (dimanche). Les sept : tous les jours.
  weekdays          Int[]
  /// Habitude mise en pause : elle n'apparaît plus dans le suivi.
  archivedAt        DateTime?  @map("archived_at") @db.Timestamptz(3)
  /// Moment de la journée choisi (calendrier « Semaine ») ; null : dans la journée.
  moment            DayMoment?
  /// Plan de « Mon développement » d'où vient l'habitude ; détachée si le plan est supprimé.
  developmentPlanId String?    @map("development_plan_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  developmentPlan DevelopmentPlan?  @relation(fields: [developmentPlanId], references: [id], onDelete: SetNull)
  completions     HabitCompletion[]
  pactMembers     PactMember[]

  @@index([userId, archivedAt])
  @@index([goalId])
  @@index([developmentPlanId])
  @@map("habits")
}

/// Jour où une habitude a été faite (jour du calendrier dans le fuseau de l'utilisateur).
model HabitCompletion {
  id        String   @id @default(uuid(7)) @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@unique([habitId, day])
  @@map("habit_completions")
}

/// Check-in quotidien : comment l'utilisateur se sent, une fois par jour (§29).
model DailyCheckIn {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Jour du calendrier dans le fuseau de l'utilisateur.
  day       DateTime @db.Date
  /// Notes de 1 à 5 (5 : au mieux, sauf le stress où 5 est le plus élevé).
  mood      Int      @db.SmallInt
  energy    Int      @db.SmallInt
  stress    Int      @db.SmallInt
  sleep     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@unique([userId, day])
  @@map("daily_check_ins")
}

/// Page du journal : une par jour, privée (jamais envoyée à Get iT AI ni
/// montrée à quelqu'un d'autre). Une page de texte libre.
model JournalEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Jour du calendrier dans le fuseau de l'utilisateur.
  day       DateTime @db.Date
  /// Texte libre de la page (jamais vide : une page vidée est supprimée).
  body      String
  /// Mots écrits (récap), recalculé à chaque enregistrement.
  words     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@unique([userId, day])
  @@map("journal_entries")
}

/// Photo ou vidéo d'une page du journal (privée, comme la page). Rattachée au
/// jour, pas au texte : vider la page ne la supprime pas.
model JournalMedia {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Jour du calendrier de la page, dans le fuseau de l'utilisateur.
  day        DateTime  @db.Date
  kind       MediaKind
  path       String    @unique
  /// Image d'aperçu d'une vidéo.
  posterPath String?   @map("poster_path")
  width      Int
  height     Int
  durationMs Int?      @map("duration_ms")
  sizeBytes  Int       @map("size_bytes")
  /// Place sur la page (0 à 3).
  position   Int       @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, position])
  @@map("journal_media")
}

/// Action qui rapporte de l'XP (§6).
enum XpSource {
  habit_day
  task
  milestone
  goal
  check_in
  journal
}

/// XP gagnée par une action (§54 XPEvent). Chaque ligne pointe vers son action
/// (une seule) : annuler ou supprimer l'action retire son XP (cascade).
model XpEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  source            XpSource
  amount            Int      @db.SmallInt
  /// Pilier crédité ; null pour une action sans pilier (check-in, tâche sans objectif).
  pillar            Pillar?
  /// Jour où l'XP compte, dans le fuseau de l'utilisateur (plafond quotidien, historique).
  day               DateTime @db.Date
  habitCompletionId String?  @unique @map("habit_completion_id") @db.Uuid
  taskId            String?  @unique @map("task_id") @db.Uuid
  milestoneId       String?  @unique @map("milestone_id") @db.Uuid
  goalId            String?  @unique @map("goal_id") @db.Uuid
  checkInId         String?  @unique @map("check_in_id") @db.Uuid
  journalEntryId    String?  @unique @map("journal_entry_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitCompletion HabitCompletion? @relation(fields: [habitCompletionId], references: [id], onDelete: Cascade)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone       GoalMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  checkIn         DailyCheckIn?    @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([userId, source, day])
  @@map("xp_events")
}

/// Usage de Get iT AI.
enum AiRequestKind {
  coach
  goal_plan
  development_plan
  /// Modification d'un plan existant : ne compte pas dans les 3 plans par jour.
  development_revision
  /// Analyse d'un niveau Ranked.
  ranked_analysis
}

/// Évaluation du mode Ranked : une par passage, la plus récente fait foi.
/// Niveaux physique et financier de 1 à 100 (pourcentage du Canada et des
/// États-Unis dépassé, par âge) ; le total est leur moyenne. Tous publics.
model RankedEvaluation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Réponses validées (rankedAnswersSchema) : renseignements sensibles, jamais montrés aux autres.
  answers   Json
  /// Détail du calcul : percentile et source de chaque facteur.
  result    Json
  physical  Int      @db.SmallInt
  financial Int      @db.SmallInt
  total     Int      @db.SmallInt
  /// Analyse de Get iT AI, si la personne l'a demandée.
  analysis  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ranked_evaluations")
}

/// Requête faite à Get iT AI : limite quotidienne et suivi des coûts (jetons).
model AiRequest {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  kind             AiRequestKind
  /// Jour dans le fuseau de l'utilisateur (limite quotidienne).
  day              DateTime      @db.Date
  model            String
  inputTokens      Int           @default(0) @map("input_tokens")
  outputTokens     Int           @default(0) @map("output_tokens")
  cacheReadTokens  Int           @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int           @default(0) @map("cache_write_tokens")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@map("ai_requests")
}

enum CoachRole {
  user
  assistant
}

/// Conversation avec Get iT AI (§15).
model CoachConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Début du premier message, pour retrouver la conversation.
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile  Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
  @@map("coach_conversations")
}

model CoachMessage {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  role           CoachRole
  content        String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      CoachAction[]

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

enum CoachActionKind {
  goal
  habit
  task
  milestone
}

enum CoachActionStatus {
  pending
  applied
  dismissed
}

/// Ajout proposé par Get iT AI dans une réponse : rien n'est créé sans l'accord de l'utilisateur.
model CoachAction {
  id        String            @id @default(uuid(7)) @db.Uuid
  messageId String            @map("message_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  kind      CoachActionKind
  /// Proposition validée (titre, pilier, jours, échéance, objectif lié).
  payload   Json
  status    CoachActionStatus @default(pending)
  /// Élément créé une fois la proposition acceptée (objectif, habitude…).
  createdId String?           @map("created_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  message CoachMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId, status])
  @@map("coach_actions")
}

enum PostKind {
  text
  question
  progress
}

/// Visibilité d'un contenu : masqué automatiquement après plusieurs
/// signalements (en attente de décision), ou retiré par la modération.
enum ContentStatus {
  visible
  hidden
  removed
}

/// Publication du Centre Get iT (§17-18).
model Post {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  kind         PostKind
  /// Texte, ou message facultatif d'un progrès partagé.
  body         String
  pillar       Pillar?
  /// Progrès partagé, figé au moment du partage (objectif atteint, niveau…).
  progress     Json?
  status       ContentStatus @default(visible)
  /// Photos ou vidéo jointes (0 à 4) : une publication avec médias peut être sans texte.
  mediaCount   Int           @default(0) @map("media_count") @db.SmallInt
  /// Partage dans son fil : la publication d'origine (le partage disparaît avec elle).
  sharedPostId String?       @map("shared_post_id") @db.Uuid
  /// Publication du forum d'un groupe public (absente du fil du Centre).
  groupId      String?       @map("group_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile    Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedPost Post?           @relation("PostShares", fields: [sharedPostId], references: [id], onDelete: Cascade)
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  shares     Post[]          @relation("PostShares")
  comments   PostComment[]
  reactions  PostReaction[]
  reports    ContentReport[]
  media      PostMedia[]
  saves      PostSave[]
  messages   Message[]

  @@unique([userId, sharedPostId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([sharedPostId])
  @@index([groupId, createdAt])
  @@map("posts")
}

/// Groupe public : un forum ; groupe privé : une discussion sur invitation.
enum GroupVisibility {
  public
  private
}

enum GroupRole {
  owner
  admin
  member
}

enum GroupMemberStatus {
  active
  /// Invitation à un groupe privé, pas encore acceptée.
  invited
}

/// Groupe du Centre Get iT, sur un pilier ou général (pilier vide).
model Group {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String
  description String          @default("")
  pillar      Pillar?
  visibility  GroupVisibility
  ownerId     String          @map("owner_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        Profile       @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  posts        Post[]
  conversation Conversation?

  @@index([visibility, createdAt])
  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  groupId     String            @map("group_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  role        GroupRole         @default(member)
  status      GroupMemberStatus @default(active)
  invitedById String?           @map("invited_by_id") @db.Uuid
  joinedAt    DateTime?         @map("joined_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile   Profile  @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy Profile? @relation("GroupInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@id([groupId, userId])
  @@index([userId, status])
  @@index([invitedById])
  @@map("group_members")
}

/// Publication enregistrée (Profil › Publications › Enregistrées). Privé :
/// jamais montré à l'auteur.
model PostSave {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
  @@map("post_saves")
}

model PostComment {
  id        String        @id @default(uuid(7)) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  body      String
  status    ContentStatus @default(visible)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  post    Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ContentReport[]

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("post_comments")
}

/// « Bravo » sur une publication : une seule réaction par personne.
model PostReaction {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_reactions")
}

enum ReportReason {
  spam
  harassment
  hate
  self_harm
  inappropriate
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

/// Signalement (§44) d'une publication, d'un commentaire ou d'une personne.
model ContentReport {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  postId         String?      @map("post_id") @db.Uuid
  commentId      String?      @map("comment_id") @db.Uuid
  reportedUserId String?      @map("reported_user_id") @db.Uuid
  messageId      String?      @map("message_id") @db.Uuid
  reason         ReportReason
  details        String?
  status         ReportStatus @default(open)
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter     Profile      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reportedUser Profile?     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  resolvedBy   Profile?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, reportedUserId])
  @@unique([reporterId, messageId])
  @@index([status, createdAt])
  @@map("content_reports")
}

/// Blocage : les deux personnes ne voient plus le contenu l'une de l'autre.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker Profile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// Place d'un participant dans une conversation privée.
enum ConversationMemberStatus {
  /// Conversation acceptée : dans les Discussions.
  accepted
  /// Premier message d'une personne inconnue : dans les Demandes, en attente.
  request
}

enum MessageKind {
  text
  /// Progrès réel, figé au moment de l'envoi (comme dans le Centre).
  progress
  /// Étape d'un pacte (proposition, fin) : affichée selon l'état du pacte.
  pact
  /// Publication du Centre envoyée dans la conversation (mot facultatif).
  post
}

/// Réactions de la Messagerie : Bravo, Force, Fier de toi, Merci.
enum MessageReactionKind {
  bravo
  force
  proud
  thanks
}

/// Conversation privée entre deux membres du Centre (une seule par paire).
model Conversation {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Les deux identifiants triés, « idA:idB » : empêche les doublons (vide pour un groupe).
  directKey     String?  @unique @map("direct_key")
  /// Discussion d'un groupe privé (sans clé de paire).
  groupId       String?  @unique @map("group_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy Profile              @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  group     Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]
  pacts     Pact[]

  @@index([createdById, createdAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String                   @map("conversation_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  status         ConversationMemberStatus @default(accepted)
  /// Dernière lecture : sert seulement au nombre de non-lus (pas de « Vu »).
  lastReadAt     DateTime?                @map("last_read_at") @db.Timestamptz(3)
  /// Conversation supprimée de son côté : les messages d'avant restent cachés.
  clearedAt      DateTime?                @map("cleared_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  kind           MessageKind @default(text)
  /// Texte, ou mot facultatif accompagnant un progrès ; vide une fois supprimé.
  body           String      @default("")
  /// Progrès figé (même forme que posts.progress).
  progress       Json?
  /// Pacte dont ce message marque une étape (« proposed », « ended », « cancelled » dans body).
  pactId         String?     @map("pact_id") @db.Uuid
  /// Publication envoyée (message « post ») ; vide si elle a été supprimée.
  postId         String?     @map("post_id") @db.Uuid
  /// Photos ou vidéo jointes (0 à 4) : un message avec médias peut être sans texte.
  mediaCount     Int         @default(0) @map("media_count") @db.SmallInt
  /// Supprimé par son auteur ou retiré par la modération : contenu effacé.
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  pact         Pact?             @relation(fields: [pactId], references: [id], onDelete: Cascade)
  post         Post?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  media        MessageMedia[]
  reactions    MessageReaction[]
  reports      ContentReport[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([postId])
  @@map("messages")
}

/// Photo ou vidéo d'un message privé (fichier privé, lu par des liens temporaires).
model MessageMedia {
  id         String    @id @default(uuid(7)) @db.Uuid
  messageId  String    @map("message_id") @db.Uuid
  kind       MediaKind
  path       String    @unique
  /// Image d'aperçu d'une vidéo.
  posterPath String?   @map("poster_path")
  width      Int
  height     Int
  durationMs Int?      @map("duration_ms")
  sizeBytes  Int       @map("size_bytes")
  position   Int       @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, position])
  @@map("message_media")
}

model MessageReaction {
  messageId String              @map("message_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  kind      MessageReactionKind
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reactions")
}

/// Règle de réussite d'un pacte.
enum PactRule {
  /// Chaque jour, pour les deux.
  daily
  /// Au moins 80 % des jours (arrondi au-dessus).
  most
}

enum PactStatus {
  proposed
  active
  declined
  /// Quitté (ou retiré) par l'un des deux.
  cancelled
  /// Arrivé à son dernier jour.
  ended
}

enum PactOutcome {
  success
  failed
}

/// Pacte : défi à deux dans une conversation, chacun avec son habitude.
model Pact {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  proposedById   String       @map("proposed_by_id") @db.Uuid
  title          String
  pillar         Pillar
  /// Durée en jours : 7, 14 ou 30.
  days           Int
  rule           PactRule     @default(most)
  status         PactStatus   @default(proposed)
  /// Premier et dernier jour (calendrier), fixés à l'acceptation.
  startsOn       DateTime?    @map("starts_on") @db.Date
  endsOn         DateTime?    @map("ends_on") @db.Date
  outcome        PactOutcome?
  /// Qui l'a quitté : jamais affiché à l'autre (« Le pacte est terminé »).
  endedById      String?      @map("ended_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposedBy   Profile      @relation("PactProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  endedBy      Profile?     @relation("PactEnder", fields: [endedById], references: [id], onDelete: SetNull)
  members      PactMember[]
  messages     Message[]

  @@index([conversationId, status])
  @@index([proposedById, createdAt])
  @@map("pacts")
}

/// Participant d'un pacte et l'habitude qu'il y relie (seul son « fait / pas fait » est partagé).
model PactMember {
  pactId   String    @map("pact_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  /// Détachée si l'habitude est supprimée.
  habitId  String?   @map("habit_id") @db.Uuid
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(3)

  pact    Pact    @relation(fields: [pactId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit   Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@id([pactId, userId])
  @@index([userId])
  @@index([habitId])
  @@map("pact_members")
}

enum MediaKind {
  image
  video
}

/// Fichier envoyé au stockage (compartiment « media »), en attente d'être joint
/// à une publication ; un envoi jamais utilisé est supprimé au bout d'un jour.
model MediaUpload {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      MediaKind
  /// Chemin dans le compartiment : posts/<userId>/<id>.<extension>
  path      String    @unique
  mimeType  String    @map("mime_type")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("media_uploads")
}

/// Photo ou vidéo d'une publication (fichier privé, lu par des liens temporaires).
model PostMedia {
  id         String    @id @default(uuid(7)) @db.Uuid
  postId     String    @map("post_id") @db.Uuid
  kind       MediaKind
  path       String
  /// Image d'aperçu d'une vidéo.
  posterPath String?   @map("poster_path")
  width      Int
  height     Int
  durationMs Int?      @map("duration_ms")
  sizeBytes  Int       @map("size_bytes")
  position   Int       @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_media")
}

enum ContactStatus {
  /// Demande envoyée, en attente de réponse.
  pending
  accepted
}

/// Contact (ami) entre deux membres du Centre : une demande, puis une relation acceptée.
model Contact {
  id          String        @id @default(uuid(7)) @db.Uuid
  requesterId String        @map("requester_id") @db.Uuid
  addresseeId String        @map("addressee_id") @db.Uuid
  /// Les deux identifiants triés, « idA:idB » : une seule relation par paire.
  pairKey     String        @unique @map("pair_key")
  status      ContactStatus @default(pending)
  respondedAt DateTime?     @map("responded_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  requester Profile @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Profile @relation("ContactAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("contacts")
}

enum ListingKind {
  /// Service d'un professionnel (coach, nutritionniste, conseiller, psychologue…).
  service
  /// Produit : vêtements, équipement, livres…
  gear
}

enum ListingStatus {
  /// En attente de l'approbation de l'équipe Get iT.
  pending
  approved
  rejected
  /// Retirée par son vendeur.
  archived
}

/// Annonce du Marketplace, proposée par un affilié. Visible seulement une fois
/// approuvée par l'équipe Get iT ; les coordonnées (nom, courriel, permis) ne
/// servent qu'à l'équipe et ne sont jamais montrées aux acheteurs.
model Listing {
  id            String        @id @default(uuid(7)) @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  kind          ListingKind
  status        ListingStatus @default(pending)
  pillar        Pillar
  /// Type d'annonce (ex. « fitness_coach », « clothing ») : voir src/features/marketplace/rules.ts.
  category      String
  title         String
  /// Courte description affichée dans le catalogue.
  summary       String
  description   String
  /// Prix (gear) ou début de la fourchette (service), en cents.
  priceMinCents Int           @map("price_min_cents")
  /// Fin de la fourchette d'un service ; null : prix unique.
  priceMaxCents Int?          @map("price_max_cents")
  currency      String        @default("CAD")
  /// « session », « hour », « month », « package » (service) ou « item » (gear).
  priceUnit     String        @map("price_unit")
  /// Régions desservies (services) : codes de src/features/marketplace/rules.ts.
  regions       String[]      @default([])
  contactName   String        @map("contact_name")
  contactEmail  String        @map("contact_email")
  website       String?
  socialUrl     String?       @map("social_url")
  /// Numéro de permis d'une profession réglementée (ordre professionnel, AMF).
  licenseNumber String?       @map("license_number")
  mediaCount    Int           @default(0) @map("media_count") @db.SmallInt
  /// Raison d'un refus, montrée au vendeur.
  reviewNote    String?       @map("review_note")
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller    Profile           @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer  Profile?          @relation("ListingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  media     ListingMedia[]
  favorites ListingFavorite[]

  @@index([status, kind, pillar, createdAt])
  @@index([sellerId, createdAt])
  @@map("listings")
}

/// Photo d'une annonce (fichier privé, lu par des liens temporaires).
model ListingMedia {
  id        String   @id @default(uuid(7)) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  path      String
  width     Int
  height    Int
  sizeBytes Int      @map("size_bytes")
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("listing_media")
}

/// Plans de « Mon développement » : un par pilier, plus le plan d'entreprise.
enum DevelopmentKind {
  physical
  mental
  social
  financial
  business
}

/// Plan personnalisé par Get iT AI à partir d'un questionnaire. Les réponses
/// (renseignements sensibles : santé, finances) restent privées ; supprimer le
/// plan les supprime aussi. Un seul plan par type et par personne.
model DevelopmentPlan {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  kind      DevelopmentKind
  /// Réponses au questionnaire, revalidées par src/features/development/questionnaires.ts.
  answers   Json
  /// Plan normalisé (src/features/development/plan.ts).
  plan      Json
  /// Période du plan dans le calendrier : la semaine type s'y répète.
  startsOn  DateTime        @map("starts_on") @db.Date
  endsOn    DateTime        @map("ends_on") @db.Date
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals   Goal[]
  habits  Habit[]
  tasks   Task[]

  @@unique([userId, kind])
  @@map("development_plans")
}

/// Annonce gardée en favori par un acheteur. Privé : jamais montré au vendeur ni aux autres.
model ListingFavorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@index([userId, createdAt])
  @@map("listing_favorites")
}
