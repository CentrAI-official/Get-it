// Schéma de la base de données Get iT.
// Conventions : modèles en PascalCase, tables et colonnes en snake_case (@@map / @map),
// dates avec fuseau horaire (timestamptz).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Langues de l'interface. Doit rester aligné avec src/i18n/routing.ts.
enum Locale {
  fr
  en
}

/// Les quatre piliers. Doit rester aligné avec src/config/pillars.ts.
enum Pillar {
  physical
  mental
  social
  financial
}

/// Situation professionnelle déclarée à l'onboarding. Alignée avec src/features/onboarding/schemas.ts.
enum Occupation {
  student
  employee
  self_employed
  entrepreneur
  job_seeker
  other
}

enum GoalStatus {
  active
  completed
  archived
}

/// Profil d'un utilisateur. L'id est celui du compte Supabase Auth (auth.users.id).
/// Rôle dans la plateforme (§43) ; les permissions sont vérifiées côté serveur.
enum UserRole {
  user
  moderator
  admin
}

model Profile {
  id             String      @id @db.Uuid
  /// Nom d'utilisateur public du Centre Get iT (minuscules, chiffres, « _ »).
  username       String?     @unique
  role           UserRole    @default(user)
  /// Suspension du Centre Get iT par la modération ; null : pas suspendu.
  suspendedUntil DateTime?   @map("suspended_until") @db.Timestamptz(3)
  /// Prénom ou nom affiché, demandé à l'onboarding.
  displayName    String?     @map("display_name")
  occupation     Occupation?
  /// Piliers que l'utilisateur veut améliorer en priorité.
  focusPillars   Pillar[]    @default([]) @map("focus_pillars")
  /// Fin de l'onboarding ; null tant qu'il n'est pas terminé.
  onboardedAt    DateTime?   @map("onboarded_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings           UserSettings?
  goals              Goal[]
  tasks              Task[]
  habits             Habit[]
  checkIns           DailyCheckIn[]
  assessments        PillarAssessment[]
  xpEvents           XpEvent[]
  aiRequests         AiRequest[]
  coachConversations CoachConversation[]
  coachActions       CoachAction[]
  posts              Post[]
  postComments       PostComment[]
  postReactions      PostReaction[]
  reportsMade        ContentReport[]     @relation("ReportReporter")
  reportsReceived    ContentReport[]     @relation("ReportedUser")
  reportsResolved    ContentReport[]     @relation("ReportResolver")
  blocking           UserBlock[]         @relation("Blocker")
  blockedBy          UserBlock[]         @relation("Blocked")

  @@map("profiles")
}

/// Préférences personnelles, séparées du profil public.
model UserSettings {
  userId           String    @id @map("user_id") @db.Uuid
  /// Langue choisie : suit l'utilisateur sur tous ses appareils (web et future app mobile).
  locale           Locale    @default(fr)
  /// Fuseau IANA (ex. « America/Toronto ») : sert à calculer « aujourd'hui » et les séries.
  timeZone         String    @default("America/Toronto") @map("time_zone")
  /// Temps que l'utilisateur veut investir chaque jour, en minutes.
  dailyMinutes     Int?      @map("daily_minutes")
  /// Accord pour que Get iT AI reçoive les données de l'utilisateur (Loi 25) ; null : pas d'accord.
  aiConsentAt      DateTime? @map("ai_consent_at") @db.Timestamptz(3)
  /// Acceptation des règles du Centre Get iT, avant la première publication.
  communityRulesAt DateTime? @map("community_rules_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Objectif de l'utilisateur, découpé en jalons et en tâches.
model Goal {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  title       String
  description String?
  pillar      Pillar
  status      GoalStatus @default(active)
  /// Jour visé : une date du calendrier, sans heure ni fuseau.
  targetDate  DateTime?  @map("target_date") @db.Date
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile    Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  tasks      Task[]
  habits     Habit[]
  /// XP de l'objectif atteint.
  xpEvent    XpEvent?

  @@index([userId, status])
  @@map("goals")
}

/// Grande étape d'un objectif. L'avancement de l'objectif se calcule sur ses jalons.
model GoalMilestone {
  id          String    @id @default(uuid(7)) @db.Uuid
  goalId      String    @map("goal_id") @db.Uuid
  title       String
  /// Ordre d'affichage dans l'objectif.
  position    Int
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  goal    Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@index([goalId, position])
  @@map("goal_milestones")
}

/// Action concrète, rattachée à un objectif ou indépendante (étape 6 : page Aujourd'hui).
model Task {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  goalId      String?   @map("goal_id") @db.Uuid
  title       String
  /// Jour d'échéance : une date du calendrier, sans heure ni fuseau.
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@index([userId, completedAt])
  @@index([goalId])
  @@map("tasks")
}

/// Autoévaluation d'un pilier (1 à 5). Une ligne par évaluation : l'historique montre l'évolution.
model PillarAssessment {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pillar    Pillar
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pillar, createdAt])
  @@map("pillar_assessments")
}

/// Habitude à répéter certains jours de la semaine.
model Habit {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Objectif soutenu par l'habitude ; détaché si l'objectif est supprimé.
  goalId     String?   @map("goal_id") @db.Uuid
  title      String
  pillar     Pillar
  /// Jours prévus, de 1 (lundi) à 7 (dimanche). Les sept : tous les jours.
  weekdays   Int[]
  /// Habitude mise en pause : elle n'apparaît plus dans le suivi.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  completions HabitCompletion[]

  @@index([userId, archivedAt])
  @@index([goalId])
  @@map("habits")
}

/// Jour où une habitude a été faite (jour du calendrier dans le fuseau de l'utilisateur).
model HabitCompletion {
  id        String   @id @default(uuid(7)) @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@unique([habitId, day])
  @@map("habit_completions")
}

/// Check-in quotidien : comment l'utilisateur se sent, une fois par jour (§29).
model DailyCheckIn {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Jour du calendrier dans le fuseau de l'utilisateur.
  day       DateTime @db.Date
  /// Notes de 1 à 5 (5 : au mieux, sauf le stress où 5 est le plus élevé).
  mood      Int      @db.SmallInt
  energy    Int      @db.SmallInt
  stress    Int      @db.SmallInt
  sleep     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpEvent XpEvent?

  @@unique([userId, day])
  @@map("daily_check_ins")
}

/// Action qui rapporte de l'XP (§6).
enum XpSource {
  habit_day
  task
  milestone
  goal
  check_in
}

/// XP gagnée par une action (§54 XPEvent). Chaque ligne pointe vers son action
/// (une seule) : annuler ou supprimer l'action retire son XP (cascade).
model XpEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  source            XpSource
  amount            Int      @db.SmallInt
  /// Pilier crédité ; null pour une action sans pilier (check-in, tâche sans objectif).
  pillar            Pillar?
  /// Jour où l'XP compte, dans le fuseau de l'utilisateur (plafond quotidien, historique).
  day               DateTime @db.Date
  habitCompletionId String?  @unique @map("habit_completion_id") @db.Uuid
  taskId            String?  @unique @map("task_id") @db.Uuid
  milestoneId       String?  @unique @map("milestone_id") @db.Uuid
  goalId            String?  @unique @map("goal_id") @db.Uuid
  checkInId         String?  @unique @map("check_in_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile         Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitCompletion HabitCompletion? @relation(fields: [habitCompletionId], references: [id], onDelete: Cascade)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone       GoalMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  checkIn         DailyCheckIn?    @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([userId, source, day])
  @@map("xp_events")
}

/// Usage de Get iT AI.
enum AiRequestKind {
  coach
  goal_plan
}

/// Requête faite à Get iT AI : limite quotidienne et suivi des coûts (jetons).
model AiRequest {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  kind             AiRequestKind
  /// Jour dans le fuseau de l'utilisateur (limite quotidienne).
  day              DateTime      @db.Date
  model            String
  inputTokens      Int           @default(0) @map("input_tokens")
  outputTokens     Int           @default(0) @map("output_tokens")
  cacheReadTokens  Int           @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int           @default(0) @map("cache_write_tokens")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@map("ai_requests")
}

enum CoachRole {
  user
  assistant
}

/// Conversation avec Get iT AI (§15).
model CoachConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Début du premier message, pour retrouver la conversation.
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile  Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
  @@map("coach_conversations")
}

model CoachMessage {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  role           CoachRole
  content        String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      CoachAction[]

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

enum CoachActionKind {
  goal
  habit
  task
  milestone
}

enum CoachActionStatus {
  pending
  applied
  dismissed
}

/// Ajout proposé par Get iT AI dans une réponse : rien n'est créé sans l'accord de l'utilisateur.
model CoachAction {
  id        String            @id @default(uuid(7)) @db.Uuid
  messageId String            @map("message_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  kind      CoachActionKind
  /// Proposition validée (titre, pilier, jours, échéance, objectif lié).
  payload   Json
  status    CoachActionStatus @default(pending)
  /// Élément créé une fois la proposition acceptée (objectif, habitude…).
  createdId String?           @map("created_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  message CoachMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId, status])
  @@map("coach_actions")
}

enum PostKind {
  text
  question
  progress
}

/// Visibilité d'un contenu : masqué automatiquement après plusieurs
/// signalements (en attente de décision), ou retiré par la modération.
enum ContentStatus {
  visible
  hidden
  removed
}

/// Publication du Centre Get iT (§17-18).
model Post {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      PostKind
  /// Texte, ou message facultatif d'un progrès partagé.
  body      String
  pillar    Pillar?
  /// Progrès partagé, figé au moment du partage (objectif atteint, niveau…).
  progress  Json?
  status    ContentStatus @default(visible)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile   Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  PostComment[]
  reactions PostReaction[]
  reports   ContentReport[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("posts")
}

model PostComment {
  id        String        @id @default(uuid(7)) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  body      String
  status    ContentStatus @default(visible)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  post    Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ContentReport[]

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("post_comments")
}

/// « Bravo » sur une publication : une seule réaction par personne.
model PostReaction {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_reactions")
}

enum ReportReason {
  spam
  harassment
  hate
  self_harm
  inappropriate
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

/// Signalement (§44) d'une publication, d'un commentaire ou d'une personne.
model ContentReport {
  id             String       @id @default(uuid(7)) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  postId         String?      @map("post_id") @db.Uuid
  commentId      String?      @map("comment_id") @db.Uuid
  reportedUserId String?      @map("reported_user_id") @db.Uuid
  reason         ReportReason
  details        String?
  status         ReportStatus @default(open)
  resolvedById   String?      @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter     Profile      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reportedUser Profile?     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy   Profile?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, reportedUserId])
  @@index([status, createdAt])
  @@map("content_reports")
}

/// Blocage : les deux personnes ne voient plus le contenu l'une de l'autre.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker Profile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}
